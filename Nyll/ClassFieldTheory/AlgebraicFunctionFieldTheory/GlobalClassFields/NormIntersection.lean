import Nyll.ClassFieldTheory.AlgebraicFunctionFieldTheory.GlobalClassFields.SubextensionCorrespondence

/-!
# Norms from intersections of finite abelian class fields

The norm group of the actual intersection is the subgroup generated by
the two norm groups. Its proof constructs an intermediate class field
inside a known finite extension and applies norm-order reflection.
-/

noncomputable section

namespace FunctionField

variable (k K : Type) [Field k] [Finite k] [Field K] [Algebra k K]
    [Algebra (RatFunc k) K] [IsScalarTower k (RatFunc k) K] [FunctionField k K]
    [AlgebraicCurve.HasPrincipalDivisors k K]

/-- The norm group of an abelian intersection is the join of the two norm groups. -/
theorem finiteAbelian_norm_range_inf
    (E F : IntermediateField K (SeparableClosure K))
    [FiniteDimensional K E] [IsAbelianGalois K E]
    [FiniteDimensional K F] [IsAbelianGalois K F] :
    let _ : Algebra k (SeparableClosure K) :=
      ((algebraMap K (SeparableClosure K)).comp (algebraMap k K)).toAlgebra
    let _ : Algebra (RatFunc k) (SeparableClosure K) :=
      ((algebraMap K (SeparableClosure K)).comp (algebraMap (RatFunc k) K)).toAlgebra
    let _ : IsScalarTower k K (SeparableClosure K) :=
      IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    let _ : IsScalarTower (RatFunc k) K (SeparableClosure K) :=
      IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    let _ : IsScalarTower k (RatFunc k) (SeparableClosure K) :=
      IsScalarTower.of_algebraMap_eq (fun x => congrArg (algebraMap K (SeparableClosure K))
        (IsScalarTower.algebraMap_apply k (RatFunc k) K x))
    let i : ↥(E ⊓ F) →ₐ[K] E := IntermediateField.inclusion inf_le_left
    let _ : FiniteDimensional K ↥(E ⊓ F) :=
      FiniteDimensional.of_injective i.toLinearMap i.injective
    let _ : IsAbelianGalois K ↥(E ⊓ F) := IsAbelianGalois.of_algHom i
    (IdeleClassGroup.norm (k := k) (K := K) (L := ↥(E ⊓ F))).range =
      (IdeleClassGroup.norm (k := k) (K := K) (L := E)).range ⊔
        (IdeleClassGroup.norm (k := k) (K := K) (L := F)).range := by
  intro akΩ aRΩ hkKΩ hRKΩ hkRΩ i hIfinite hIab
  let U := (IdeleClassGroup.norm (k := k) (K := K) (L := E)).range ⊔
    (IdeleClassGroup.norm (k := k) (K := K) (L := F)).range
  obtain ⟨T, hTfinite, hTab, hTE, hTU⟩ :=
    exists_subextension_norm_eq k K E U le_sup_left
  have hFT := (show (IdeleClassGroup.norm (k := k) (K := K) (L := F)).range ≤ U
    from le_sup_right).trans hTU.ge
  have hTF := (finiteAbelian_norm_range_le_iff k K F T).mp hFT
  have hIT := (finiteAbelian_norm_range_le_iff k K (E ⊓ F) T).mpr (le_inf hTE hTF)
  have hEI := (finiteAbelian_norm_range_le_iff k K E (E ⊓ F)).mpr
    (show E ⊓ F ≤ E from inf_le_left)
  have hFI := (finiteAbelian_norm_range_le_iff k K F (E ⊓ F)).mpr
    (show E ⊓ F ≤ F from inf_le_right)
  with_reducible exact le_antisymm (hIT.trans hTU.le) (sup_le hEI hFI)

end FunctionField
