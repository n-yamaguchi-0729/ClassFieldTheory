import Nyll.ClassFieldTheory.AlgebraicFunctionFieldTheory.Artin.GlobalDecomposition
import Nyll.ClassFieldTheory.AlgebraicFunctionFieldTheory.Idele.ClassGroup.IntegralUnits
import Nyll.ClassFieldTheory.AlgebraicFunctionFieldTheory.Idele.OnePlaceDetermination

/-!
# Integral ideles and original residue inertia

The existing product of the original one-place ideles proves that a
continuous homomorphism sends integral idele classes into a closed subgroup
exactly when it sends every original local unit there. Applying the actual
local-global Artin formula identifies the finite Artin image of integral
idele classes with the subgroup generated by the original residue inertia.
-/

noncomputable section

open AlgebraicCurve
open scoped IsMulCommutative

namespace FunctionField

variable {k K : Type*} [Field k] [Field K] [Algebra k K]

/-- Inserting an original integral unit at one place gives an everywhere
integral idele. -/
theorem IdeleGroup.placeIdele_mem_integralSubgroup
    (v : Place k K) (x : v.adicCompletionˣ)
    (hx : x ∈ v.adicCompletionIntegers.units) :
    IdeleGroup.placeIdele v x ∈ IdeleGroup.integralSubgroup := by
  intro w
  change IdeleGroup.component w (IdeleGroup.placeIdele v x) ∈ _
  by_cases h : w = v
  · subst w
    rw [IdeleGroup.component_placeIdele_same]
    exact hx
  · rw [IdeleGroup.component_placeIdele_of_ne v w x h]
    exact Subgroup.one_mem _

variable [HasPrincipalDivisors k K]

/-- A closed subgroup contains the image of all integral idele classes
exactly when it contains the images of all original one-place units. -/
theorem IdeleClassGroup.map_integralSubgroup_le_iff_placeUnits
    {G : Type*} [CommGroup G] [TopologicalSpace G]
    (f : IdeleClassGroup k K →* G) (hf : Continuous f)
    (H : Subgroup G) (hH : IsClosed (H : Set G)) :
    (IdeleClassGroup.integralSubgroup (k := k) (K := K)).map f ≤ H ↔
      ∀ (v : Place k K) (x : v.adicCompletionˣ),
        x ∈ v.adicCompletionIntegers.units →
        f (IdeleClassGroup.mk (IdeleGroup.placeIdele v x)) ∈ H := by
  constructor
  · intro h v x hx
    exact h ⟨IdeleClassGroup.mk (IdeleGroup.placeIdele v x),
      ⟨IdeleGroup.placeIdele v x,
        IdeleGroup.placeIdele_mem_integralSubgroup v x hx, rfl⟩, rfl⟩
  · intro h y hy
    obtain ⟨c, hc, rfl⟩ := hy
    obtain ⟨a, ha, rfl⟩ := hc
    have hp := (IdeleGroup.hasProd_placeIdele a).map
      (f.comp (IdeleClassGroup.mk (k := k) (K := K)))
      (hf.comp QuotientGroup.continuous_mk)
    exact hH.mem_of_tendsto hp (Filter.Eventually.of_forall fun s =>
      H.prod_mem fun v _ => h v (a v) (ha v))

section FiniteArtin

variable {k K L : Type*} [Field k] [Finite k] [Field K] [Field L]
  [Algebra k K] [Algebra k L] [Algebra K L] [IsScalarTower k K L]
  [Algebra (RatFunc k) K] [IsScalarTower k (RatFunc k) K] [FunctionField k K]
  [Algebra (RatFunc k) L] [IsScalarTower k (RatFunc k) L] [FunctionField k L]
  [FiniteDimensional K L] [IsAbelianGalois K L]
  [HasPrincipalDivisors k K] [HasPrincipalDivisors k L]

/-- The actual finite Artin image of integral idele classes is generated
by the actual residue inertia subgroups in the same relative Galois group. -/
theorem abelianFiniteArtin_integralSubgroup :
    (IdeleClassGroup.integralSubgroup (k := k) (K := K)).map
        (abelianFiniteArtin k K L) =
      ⨆ w : Place k L,
        (IdeleGroup.decompositionResidueAut (K := K) w).ker.map
          (IdeleGroup.decompositionGroup (K := K) w).subtype := by
  apply le_antisymm
  · apply (IdeleClassGroup.map_integralSubgroup_le_iff_placeUnits
      (abelianFiniteArtin k K L) (continuous_abelianFiniteArtin k K L) _
      (Set.toFinite _).isClosed).mpr
    intro v x hx
    obtain ⟨w, rfl⟩ := Place.exists_restrict_eq (M := L) v
    apply (le_iSup (fun w : Place k L =>
      (IdeleGroup.decompositionResidueAut (K := K) w).ker.map
        (IdeleGroup.decompositionGroup (K := K) w).subtype) w)
    rw [← abelianFiniteArtin_placeIdele_units w]
    refine ⟨x, ?_, rfl⟩
    rwa [RayClass.localHigherUnitGroup_zero]
  · apply iSup_le
    intro w
    rw [← abelianFiniteArtin_placeIdele_units w]
    rintro σ ⟨x, hx, rfl⟩
    refine ⟨IdeleClassGroup.mk (IdeleGroup.placeIdele (w.restrict K) x),
      ⟨IdeleGroup.placeIdele (w.restrict K) x, ?_, rfl⟩, rfl⟩
    apply IdeleGroup.placeIdele_mem_integralSubgroup
    rwa [RayClass.localHigherUnitGroup_zero] at hx

end FiniteArtin

end FunctionField
