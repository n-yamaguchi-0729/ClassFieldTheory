module

public import Nyll.ClassFieldTheory.Algebra.NormalEmbeddingRange
public import Nyll.ClassFieldTheory.LocalClassFieldTheory.ClassFormation.LocalizedCompletionCohomology.Algebra
public import Nyll.ValuedFieldTheory.Valuation.Completion.DegreeNormTrace
public import Mathlib.FieldTheory.IntermediateField.Algebraic

/-! # Completed local degrees along an actual finite refinement -/

@[expose] public section

open LocalClassFieldTheory

noncomputable section
namespace AlgebraicNumberTheory.Valuations

variable {K E L : Type*} [Field K] [Field E] [Field L] [Algebra K E] [Algebra K L]
  [FiniteDimensional K E] [FiniteDimensional K L]

/-- Inside the common algebraic closure of the completed base, the
completed extension is generated by the actual embedded global field. -/
theorem localizationEmbedding_fieldRange_eq_adjoin (vK : AbsoluteValue K ℝ)
    (w : AbsoluteValueExtension vK E) :
    let _ : Algebra vK.Completion (LocalizedCompletion vK w) := localizedCompletionBaseAlgebra vK w
    (absoluteValueExtension_localizationEmbedding vK w).fieldRange =
      IntermediateField.adjoin vK.Completion
        (Set.range (absoluteValueExtension_embeddingOfExtension vK w)) := by
  intro completionAlgebra
  let F := vK.Completion
  let M := LocalizedCompletion vK w
  let j := absoluteValueExtension_localizationEmbedding vK w
  let f := AbsoluteValue.toAlgebraicLocalization vK w.1 w.2
  let A := IntermediateField.adjoin F (Set.range (absoluteValueExtension_embeddingOfExtension vK w))
  have hgen : IntermediateField.adjoin F (Set.range f) = ⊤ :=
    localizedCompletion_adjoin_range_eq_top vK w
  have hj (x : E) : absoluteValueExtension_embeddingOfExtension vK w x = j (f x) :=
    absoluteValueExtension_embeddingOfExtension_apply vK w x
  refine le_antisymm ?_ (IntermediateField.adjoin_le_iff.mpr ?_)
  · have h : IntermediateField.adjoin F (Set.range f) ≤ IntermediateField.comap j A :=
      IntermediateField.adjoin_le_iff.mpr (by
        rintro _ ⟨x, rfl⟩
        change j (f x) ∈ A
        rw [← hj x]
        exact IntermediateField.subset_adjoin F _ ⟨x, rfl⟩)
    rw [hgen] at h
    rintro _ ⟨x, rfl⟩
    exact h IntermediateField.mem_top
  · rintro _ ⟨x, rfl⟩
    exact ⟨f x, (hj x).symm⟩

/-- The local degree of a finite normal field divides the local degree of
any actual refinement of it. The selected extensions of the base place can
be chosen independently on the two global fields. -/
theorem localizedCompletion_finrank_dvd_of_embedding [Normal K E] (j : E →ₐ[K] L)
    (vK : AbsoluteValue K ℝ) (wE : AbsoluteValueExtension vK E) (wL : AbsoluteValueExtension vK L) :
    let _ : Algebra vK.Completion (LocalizedCompletion vK wE) :=
      localizedCompletionBaseAlgebra vK wE
    let _ : Algebra vK.Completion (LocalizedCompletion vK wL) :=
      localizedCompletionBaseAlgebra vK wL
    Module.finrank vK.Completion (LocalizedCompletion vK wE) ∣
      Module.finrank vK.Completion (LocalizedCompletion vK wL) := by
  intro bE bL
  let aE := absoluteValueExtension_localizationEmbedding vK wE
  let aL := absoluteValueExtension_localizationEmbedding vK wL
  let iE := absoluteValueExtension_embeddingOfExtension vK wE
  let iL := absoluteValueExtension_embeddingOfExtension vK wL
  have hr : iE.fieldRange = (iL.comp j).fieldRange := AlgHom.fieldRange_eq_of_normal iE _
  have hsub : Set.range iE ⊆ Set.range iL := by
    intro x hx
    change x ∈ iE.fieldRange at hx
    rw [hr] at hx
    obtain ⟨y, hy⟩ := hx
    exact ⟨j y, hy⟩
  have hle : aE.fieldRange ≤ aL.fieldRange := by
    change (absoluteValueExtension_localizationEmbedding vK wE).fieldRange ≤
      (absoluteValueExtension_localizationEmbedding vK wL).fieldRange
    rw [localizationEmbedding_fieldRange_eq_adjoin vK wE,
      localizationEmbedding_fieldRange_eq_adjoin vK wL]
    exact IntermediateField.adjoin.mono vK.Completion _ _ hsub
  rw [aE.equivFieldRange.toLinearEquiv.finrank_eq, aL.equivFieldRange.toLinearEquiv.finrank_eq]
  exact IntermediateField.finrank_dvd_of_le_right hle

/-- The localized degrees above a fixed place sum to the global degree. -/
theorem sum_localizedCompletion_finrank [Algebra.IsSeparable K L]
    (vK : AbsoluteValue K ℝ) (hvK : vK.IsNontrivial) :
    let _ : Fintype (AbsoluteValueExtension vK L) :=
      completionTensorDecomposition_extensionFintype (K := K) (L := L) vK hvK
    let _ : ∀ w : AbsoluteValueExtension vK L, Algebra vK.Completion (LocalizedCompletion vK w) :=
      localizedCompletionBaseAlgebra vK
    (∑ w : AbsoluteValueExtension vK L, Module.finrank vK.Completion (LocalizedCompletion vK w)) =
      Module.finrank K L := by
  intro fintypeOwner algebraOwner
  let : ∀ w : AbsoluteValueExtension vK L, Algebra vK.Completion w.1.Completion :=
    fun w => AbsoluteValue.completionAlgebra vK w.1 w.2
  calc
    _ = ∑ w : AbsoluteValueExtension vK L, Module.finrank vK.Completion w.1.Completion := by
      apply Finset.sum_congr rfl
      intro w _
      exact (localizedCompletionEquivCompletion vK hvK w).toLinearEquiv.finrank_eq
    _ = _ := (completionDegreeNormTrace_degree (K := K) (L := L) vK hvK).symm

end AlgebraicNumberTheory.Valuations
