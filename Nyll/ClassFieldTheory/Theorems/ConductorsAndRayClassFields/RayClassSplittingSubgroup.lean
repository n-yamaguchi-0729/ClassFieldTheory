module

public import Nyll.ClassFieldTheory.Theorems.ConductorsAndRayClassFields.RayClassSubgroupPrimeSplitting
public import Nyll.ClassFieldTheory.Theorems.ConductorsAndRayClassFields.RayClassSubgroupFieldAntitone

/-!
# Specified split primes in a ray class field

The subgroup generated by the prime classes of `S` imposes simultaneous
complete splitting, provided `S` avoids the modulus. The existing subgroup
class-field correspondence makes its realization maximal with this property.
-/

@[expose] public section

open scoped NumberField

noncomputable section

namespace ClassFieldTheory

open NumberField IsDedekindDomain

variable {K : Type*} [Field K] [NumberField K]

/-- The subgroup generated by the ray classes of the prescribed split primes. -/
def rayClassSplittingSubgroup (m : RayClassModulus K)
    (S : Set (HeightOneSpectrum (𝓞 K)))
    (hS : ∀ v ∈ S, v ∉ m.finitePart.support) : Subgroup (RayClassGroup m) :=
  Subgroup.closure (Set.range fun v : S => rayClassOfFinitePrime m v.1 (hS v.1 v.2))

/-- All specified primes split exactly when their generated ray subgroup lies
in the subgroup defining the class field. -/
theorem splitsCompletely_on_set_iff_rayClassSplittingSubgroup_le
    (m : RayClassModulus K) (S : Set (HeightOneSpectrum (𝓞 K)))
    (hS : ∀ v ∈ S, v ∉ m.finitePart.support)
    (H : Subgroup (RayClassGroup m)) (R : RayClassSubgroupRealization K m H) :
    (∀ v ∈ S, FinitePrimeSplitsCompletely K R.extension v) ↔
      rayClassSplittingSubgroup m S hS ≤ H := by
  constructor
  · intro hs
    apply (Subgroup.closure_le (K := H)).mpr
    rintro _ ⟨v, rfl⟩
    exact (finitePrime_splitsCompletelyInRayClassSubgroupField_iff
      K m H R v.1 (hS v.1 v.2)).mp (hs v.1 v.2)
  · intro h v hv
    apply (finitePrime_splitsCompletelyInRayClassSubgroupField_iff
      K m H R v (hS v hv)).mpr
    exact h (Subgroup.subset_closure ⟨⟨v, hv⟩, rfl⟩)

/-- A realization of the generated subgroup is the maximal ray subfield in
which all prescribed primes split; the inclusion uses the fixed closure. -/
theorem rayClassSplittingSubgroup_maximal
    (m : RayClassModulus K) (S : Set (HeightOneSpectrum (𝓞 K)))
    (hS : ∀ v ∈ S, v ∉ m.finitePart.support)
    (RS : RayClassSubgroupRealization K m (rayClassSplittingSubgroup m S hS))
    (H : Subgroup (RayClassGroup m)) (R : RayClassSubgroupRealization K m H)
    (hs : ∀ v ∈ S, FinitePrimeSplitsCompletely K R.extension v) :
    R.extension.1 ≤ RS.extension.1 :=
  rayClassSubgroupField_antitone K m
    ((splitsCompletely_on_set_iff_rayClassSplittingSubgroup_le m S hS H R).mp hs) RS R

end ClassFieldTheory
