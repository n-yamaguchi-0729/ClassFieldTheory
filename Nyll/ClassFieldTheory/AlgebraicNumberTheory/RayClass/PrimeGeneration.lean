module

public import Nyll.ClassFieldTheory.Algebra.FractionalIdealFactorization
public import Mathlib.Algebra.Group.Subgroup.Ker
public import Mathlib.Algebra.Group.Subgroup.Finite

public import Nyll.ClassFieldTheory.AlgebraicNumberTheory.RayClass.Ideal
public import Nyll.ClassFieldTheory.AlgebraicNumberTheory.Idele.IdealMap

/-!
# Prime generation of ray ideal classes

The fractional ideals prime to a modulus are generated by their prime ideals
away from the modulus.  This is the algebraic input for comparing
Frobenius-normalized ray reciprocity maps.
-/



@[expose] public section

open scoped NumberField
open NumberField IsDedekindDomain

noncomputable section

namespace RayClass

universe u v

open scoped Classical in
/-- Two homomorphisms out of the prime-to-modulus fractional ideal group
agree if they agree on each prime ideal away from the modulus. -/
theorem primeToModulusIdeals_hom_ext
    {K : Type u} [Field K] [NumberField K]
    (m : RayClass.Modulus K)
    {G : Type v} [Monoid G]
    (f g : RayClass.primeToModulusIdeals m →* G)
    (hprime : ∀ (v : HeightOneSpectrum (𝓞 K))
      (hv : v ∉ m.finitePart.support),
        f (RayClass.primeToModulusIdeal m v hv) =
          g (RayClass.primeToModulusIdeal m v hv)) :
    f = g :=
  ClassFieldTheory.FractionalIdealFactorization.primeTo_hom_ext
    (R := 𝓞 K) (F := K) (↑m.finitePart.support) f g hprime

end RayClass
