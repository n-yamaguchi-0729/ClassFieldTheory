module

public import Nyll.ClassFieldTheory.AlgebraicNumberTheory.NumberField.OrderConductor
public import Nyll.ClassFieldTheory.AlgebraicNumberTheory.NumberField.OrderIdeals
public import Nyll.ClassFieldTheory.AlgebraicNumberTheory.NumberField.OrderInvertibleIdeal
public import Nyll.ClassFieldTheory.AlgebraicNumberTheory.NumberField.OrderIdealClass
import Nyll.ClassFieldTheory.Algebra.PrincipalFractionalIdeal
import Mathlib.LinearAlgebra.FreeModule.IdealQuotient
public import Mathlib.RingTheory.Ideal.Maps
import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.FractionalIdeal.Basic
public import Mathlib.RingTheory.FractionalIdeal.Operations
public import Mathlib.RingTheory.ClassGroup.Basic

/-!
# Principal congruences in the actual order ideal class map

An element of the original order congruent to one modulo the conductor
generates an ideal coprime to the conductor. Its upstairs principal ideal
contracts to the same downstairs principal ideal, so its value under the
actual order ideal class map is one.
-/

@[expose] public section

open scoped NumberField nonZeroDivisors

noncomputable section

namespace NumberField

variable {K : Type*} [Field K] [NumberField K]
    (O : Subalgebra ℤ K) [Module.Finite ℤ O] [IsFractionRing O K]

omit [NumberField K] [IsFractionRing O K] in
/-- A conductor congruence makes the downstairs principal ideal coprime
to the contracted conductor. -/
theorem orderPrincipalIdeal_coprime_conductor
    (a : O) (ha : orderToRingOfIntegers O a - 1 ∈ orderConductor O) :
    Ideal.span ({a} : Set O) ⊔
      (orderConductor O).comap (orderToRingOfIntegers O).toRingHom = ⊤ := by
  apply (Ideal.eq_top_iff_one _).mpr
  apply Submodule.mem_sup.mpr
  refine ⟨a, Ideal.subset_span (Set.mem_singleton a), 1 - a, ?_, ?_⟩
  · change orderToRingOfIntegers O (1 - a) ∈ orderConductor O
    simpa only [map_sub, map_one, neg_sub] using (orderConductor O).neg_mem ha
  · exact add_comm a (1 - a) |>.trans (sub_add_cancel 1 a)


/-- The actual upstairs ideal generated by a nonzero conductor congruence. -/
def orderCongruencePrincipalIdeal
    (a : O) (ha0 : a ≠ 0)
    (ha : orderToRingOfIntegers O a - 1 ∈ orderConductor O) :
    orderPrimeToConductorIdeals O :=
  ⟨Ideal.span ({orderToRingOfIntegers O a} : Set (𝓞 K)),
    ⟨(Ideal.span_singleton_eq_bot).not.mpr (by
        intro h
        apply ha0
        apply Subtype.ext
        exact congrArg (fun x : 𝓞 K => (x : K)) h),
      by
        change Ideal.span ({(orderToRingOfIntegers O).toRingHom a} : Set (𝓞 K)) ⊔
          orderConductor O = ⊤
        have h := orderIdeal_map_sup_conductor_eq_top O (Ideal.span ({a} : Set O))
          (orderPrincipalIdeal_coprime_conductor O a ha)
        rw [Ideal.map_span, Set.image_singleton] at h
        exact h⟩⟩

omit [NumberField K] [IsFractionRing O K] in
/-- Contraction of this principal ideal is the ideal of the same original
order element, not just an abstract isomorphic ideal. -/
theorem orderCongruencePrincipalIdeal_comap
    (a : O) (ha0 : a ≠ 0)
    (ha : orderToRingOfIntegers O a - 1 ∈ orderConductor O) :
    (orderCongruencePrincipalIdeal O a ha0 ha).1.comap
        (orderToRingOfIntegers O).toRingHom = Ideal.span ({a} : Set O) := by
  have h := orderIdeal_comap_map_of_coprime_conductor O
    (Ideal.span ({a} : Set O)) (orderPrincipalIdeal_coprime_conductor O a ha)
  change (Ideal.span ({(orderToRingOfIntegers O).toRingHom a} : Set (𝓞 K))).comap
    (orderToRingOfIntegers O).toRingHom = Ideal.span ({a} : Set O)
  rw [Ideal.map_span, Set.image_singleton] at h
  exact h

/-- A principal conductor congruence is killed by the original order's
actual ideal class map. -/
theorem orderIdealClassMap_orderCongruencePrincipalIdeal
    (a : O) (ha0 : a ≠ 0)
    (ha : orderToRingOfIntegers O a - 1 ∈ orderConductor O) :
    orderIdealClassMap O (orderCongruencePrincipalIdeal O a ha0 ha) = 1 := by
  change ClassGroup.mk K
    (orderContractedIdealUnit O (orderCongruencePrincipalIdeal O a ha0 ha).1
      (orderCongruencePrincipalIdeal O a ha0 ha).2.1
      (orderCongruencePrincipalIdeal O a ha0 ha).2.2) = 1
  apply ClassGroup.mk_eq_one_iff.mpr
  change ((orderContractedIdealUnit O (orderCongruencePrincipalIdeal O a ha0 ha).1
    (orderCongruencePrincipalIdeal O a ha0 ha).2.1
    (orderCongruencePrincipalIdeal O a ha0 ha).2.2 : FractionalIdeal O⁰ K) :
      Submodule O K).IsPrincipal
  refine (FractionalIdeal.isPrincipal_iff _).mpr ⟨algebraMap O K a, ?_⟩
  rw [orderContractedIdealUnit_val, orderCongruencePrincipalIdeal_comap,
    FractionalIdeal.coeIdeal_span_singleton]

private theorem orderPrincipalIdeal_coprime_conductor_of_map
    (a : O) (ha : Ideal.span ({orderToRingOfIntegers O a} : Set (𝓞 K)) ⊔
      orderConductor O = ⊤) :
    Ideal.span ({a} : Set O) ⊔
      (orderConductor O).comap (orderToRingOfIntegers O).toRingHom = ⊤ := by
  let f : O →+* 𝓞 K := (orderToRingOfIntegers O).toRingHom
  let F := orderConductor O
  let C := F.comap f
  let q : O →+* O ⧸ C := Ideal.Quotient.mk C
  let Q : 𝓞 K →+* 𝓞 K ⧸ F := Ideal.Quotient.mk F
  let j : O ⧸ C →+* 𝓞 K ⧸ F := Ideal.quotientMap F f le_rfl
  have hj : Function.Injective j := Ideal.quotientMap_injective (I := F) (f := f)
  have : Finite (𝓞 K ⧸ F) := Ideal.finiteQuotientOfFreeOfNeBot F (orderConductor_ne_bot O)
  have : Finite (O ⧸ C) := Finite.of_injective j hj
  obtain ⟨x, hx, c, hc, hsum⟩ := Submodule.mem_sup.mp ((Ideal.eq_top_iff_one _).mp ha)
  obtain ⟨y, hy⟩ := Ideal.mem_span_singleton.mp hx
  have hinv : Q y * j (q a) = 1 := by
    have hQ := congrArg Q hsum
    have hc0 : Q c = 0 := (Ideal.Quotient.eq_zero_iff_mem).mpr hc
    rw [map_add, map_one, hc0, add_zero, hy, map_mul] at hQ
    exact (mul_comm _ _).trans hQ
  have hinj : Function.Injective (fun t : O ⧸ C => q a * t) := by
    intro s t h
    apply hj
    have h' := congrArg (fun z : O ⧸ C => Q y * j z) h
    simpa only [map_mul, ← mul_assoc, hinv, one_mul] using h'
  obtain ⟨b₀, hb₀⟩ := Finite.surjective_of_injective hinj 1
  obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective b₀
  have hb : a * b - 1 ∈ C := (Ideal.Quotient.mk_eq_mk_iff_sub_mem (I := C) _ _).mp (by
    change q (a * b) = q 1
    rw [map_mul, map_one]
    exact hb₀)
  apply (Ideal.eq_top_iff_one _).mpr
  refine Submodule.mem_sup.mpr ⟨a * b, Ideal.mem_span_singleton.mpr ⟨b, rfl⟩,
    1 - a * b, ?_, by rw [add_comm, sub_add_cancel]⟩
  simpa only [neg_sub] using C.neg_mem hb

/-- An integral ideal prime to the conductor has trivial contracted class precisely when it is
generated by an element of the original order. -/
theorem orderIdealClassMap_eq_one_iff (I : orderPrimeToConductorIdeals O) :
    orderIdealClassMap O I = 1 ↔
      ∃ a : O, I.1 = Ideal.span ({orderToRingOfIntegers O a} : Set (𝓞 K)) := by
  let f : O →+* 𝓞 K := (orderToRingOfIntegers O).toRingHom
  let J : Ideal O := I.1.comap f
  let U := orderContractedIdealUnit O I.1 I.2.1 I.2.2
  have hU : (U : FractionalIdeal O⁰ K) = J := orderContractedIdealUnit_val O I.1 I.2.1 I.2.2
  change ClassGroup.mk K U = 1 ↔ _
  constructor
  · intro h
    have hprincipal : ((J : FractionalIdeal O⁰ K) : Submodule O K).IsPrincipal := by
      rw [← hU]
      exact ClassGroup.mk_eq_one_iff.mp h
    obtain ⟨z, hspan⟩ := (FractionalIdeal.isPrincipal_iff _).mp hprincipal
    have hzJ : (z : K) ∈ (J : FractionalIdeal O⁰ K) := by
      rw [hspan]
      exact FractionalIdeal.mem_spanSingleton_self O⁰ (z : K)
    obtain ⟨a, _, ha⟩ := (FractionalIdeal.mem_coeIdeal O⁰).mp hzJ
    have hJ : J = Ideal.span ({a} : Set O) := by
      apply FractionalIdeal.coeIdeal_injective (K := K)
      change (J : FractionalIdeal O⁰ K) = (Ideal.span ({a} : Set O) : FractionalIdeal O⁰ K)
      exact hspan.trans ((congrArg (FractionalIdeal.spanSingleton O⁰) ha.symm).trans
        (FractionalIdeal.coeIdeal_span_singleton _).symm)
    have hI := orderIdeal_map_comap_of_coprime_conductor O I.1 I.2.2
    change J.map f = I.1 at hI
    refine ⟨a, ?_⟩
    change I.1 = Ideal.span ({f a} : Set (𝓞 K))
    rw [← hI, hJ, Ideal.map_span, Set.image_singleton]
  · rintro ⟨a, ha⟩
    have hcop := orderPrincipalIdeal_coprime_conductor_of_map O a (ha ▸ I.2.2)
    have hJ := orderIdeal_comap_map_of_coprime_conductor O (Ideal.span ({a} : Set O)) hcop
    change I.1 = Ideal.span ({f a} : Set (𝓞 K)) at ha
    change ((Ideal.span ({a} : Set O)).map f).comap f = Ideal.span ({a} : Set O) at hJ
    rw [Ideal.map_span, Set.image_singleton, ← ha] at hJ
    change J = Ideal.span ({a} : Set O) at hJ
    apply ClassGroup.mk_eq_one_iff.mpr
    change ((U : FractionalIdeal O⁰ K) : Submodule O K).IsPrincipal
    refine (FractionalIdeal.isPrincipal_iff _).mpr ⟨algebraMap O K a, ?_⟩
    rw [hU, hJ, FractionalIdeal.coeIdeal_span_singleton]

end NumberField
